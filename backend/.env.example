# ========================
# QuickTask Backend
# ========================

# Server port
PORT=8082

# MongoDB connection URI (replace <username>, <password>, <cluster>)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quicktask?retryWrites=true&w=majority

# JWT secret key for authentication
JWT_SECRET=<your_jwt_secret>

# Frontend URLs for CORS
FRONTEND_URL_DEV=http://localhost:3000
FRONTEND_URL_PROD=<your_frontend_deployed_url>
